+/* pam_faceauth.so (https://github.com/gvarsanyi/faceauth): face
+   authentication. Every non-success result is PAM_AUTHINFO_UNAVAIL, so as a
+   "sufficient" module it falls through to the password. The module itself
+   restricts use to the services allowed in /etc/faceauth/faceauth.conf and
+   to local, foreground sessions. */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+
+#include "pam-config.h"
+#include "pam-module.h"
+
+static int
+write_config_faceauth (pam_module_t *this, enum write_type op, FILE *fp)
+{
+  option_set_t *opt_set = this->get_opt_set (this, op);
+
+  if (debug)
+    debug_write_call (this, op);
+
+  if (!opt_set->is_enabled (opt_set, "is_enabled"))
+    return 0;
+
+  switch (op)
+    {
+    case AUTH:
+      fprintf (fp, "auth\tsufficient\tpam_faceauth.so\t");
+      break;
+    default:
+      break;
+    }
+
+  WRITE_CONFIG_OPTIONS
+
+  return 0;
+}
+
+GETOPT_START_1(AUTH)
+GETOPT_END_1(AUTH)
+
+PRINT_ARGS("faceauth")
+PRINT_XMLHELP("faceauth")
+
+/* ---- construct module object ---- */
+DECLARE_BOOL_OPTS_1 (is_enabled);
+DECLARE_STRING_OPTS_1 (timeout);
+DECLARE_OPT_SETS;
+
+static module_helptext_t helptext[] = {{NULL, NULL, NULL}};
+
+/* at last construct the complete module object */
+pam_module_t mod_pam_faceauth = { "pam_faceauth.so", opt_sets, helptext,
+				  &def_parse_config,
+				  &def_print_module,
+				  &write_config_faceauth,
+				  &get_opt_set,
+				  &getopt,
+				  &print_args,
+				  &print_xmlhelp,
+				  NULL,
+				  PAM_FACEAUTH_AUTH_PRIORITY,
+				  -1,
+				  -1,
+				  -1
+};
